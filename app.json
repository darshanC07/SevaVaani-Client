{
  "expo": {
    "name": "SevaVaani-Client",
    "slug": "SevaVaani-Client",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sevavaaniclient",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.project.sevavaaniclient",
      "buildProperties": {
        "reactNativeArchitectures": [
          "arm64-v8a"
        ]
      }
      
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
